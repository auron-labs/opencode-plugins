root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,mjs,json,jsonc,yaml,yml,toml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
