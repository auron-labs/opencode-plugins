{
  "name": "@auron-labs/opencode-impeccable",
  "version": "0.5.0",
  "description": "OpenCode v1/v2 port of Impeccable with typed workflow tools and the native Rust design engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "upstream-lock.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && node --test test/*.test.mjs",
    "sync": "node scripts/sync-impeccable-upstream.mjs",
    "sync:check": "node scripts/sync-impeccable-upstream.mjs check",
    "check:pack": "node scripts/check-package-contents.mjs",
    "prepublishOnly": "bun run build"
  },
  "packageManager": "bun@1.2.23",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.15",
    "@opencode/plugin": "^2.0.3"
  },
  "optionalDependencies": {
    "@impeccable/cli-darwin-arm64": "0.1.11",
    "@impeccable/cli-darwin-x64": "0.1.11",
    "@impeccable/cli-linux-x64": "0.1.11",
    "@impeccable/cli-linux-arm64": "0.1.11",
    "@impeccable/cli-windows-x64": "0.1.11"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "opencode",
    "impeccable",
    "design",
    "frontend",
    "ux",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auron-labs/opencode-plugins.git",
    "directory": "packages/opencode-impeccable"
  },
  "bugs": {
    "url": "https://github.com/auron-labs/opencode-plugins/issues"
  },
  "homepage": "https://github.com/auron-labs/opencode-plugins/tree/main/packages/opencode-impeccable"
}
