{
  "name": "@auron-labs/opencode-impeccable",
  "version": "0.3.0",
  "description": "Self-contained OpenCode port of Impeccable with editing commands, typed workflow tools, and a post-edit design detector.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "references",
    "vendor",
    "upstream-lock.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && node --test test/*.test.mjs",
    "sync": "node scripts/sync-impeccable-upstream.mjs",
    "sync:check": "node scripts/sync-impeccable-upstream.mjs check",
    "prepublishOnly": "bun run build"
  },
  "packageManager": "bun@1.2.23",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.15",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "marked": "^18.0.5"
  },
  "optionalDependencies": {
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "opencode",
    "impeccable",
    "design",
    "frontend",
    "ux",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auron-labs/opencode-plugins.git",
    "directory": "packages/opencode-impeccable"
  },
  "bugs": {
    "url": "https://github.com/auron-labs/opencode-plugins/issues"
  },
  "homepage": "https://github.com/auron-labs/opencode-plugins/tree/main/packages/opencode-impeccable"
}
